{
  "name": "kyara-extension",
  "private": true,
  "version": "0.2.1",
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "scripts": {
    "dev": "mkdir -p .firefox-profile && wxt -b firefox --mv2",
    "build": "wxt build -b firefox --mv2",
    "build:debug": "wxt build -b firefox --mv2 --mode development",
    "zip": "wxt zip -b firefox --mv2",
    "sign": "rm -rf .output/*.zip && pnpm zip && web-ext sign --channel=listed --source-dir .output/firefox-mv2 --upload-source-code .output/kyara-extension-$npm_package_version-sources.zip --amo-metadata amo-metadata.json --artifacts-dir .output/signed --api-key=$AMO_JWT_ISSUER --api-secret=$AMO_JWT_SECRET",
    "release": "scripts/release.sh",
    "dev:chrome": "wxt -b chrome",
    "build:chrome": "wxt build -b chrome",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check": "biome check . && wxt prepare && tsc --noEmit",
    "postinstall": "wxt prepare"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.5",
    "@vitest/coverage-v8": "^5.1.0",
    "happy-dom": "^21.0.4",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "web-ext": "^10.8.0",
    "wxt": "^0.21.5"
  }
}
